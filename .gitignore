Makefile
Makefile.*
*.Debug
*.Release
.qmake.stash
object_script.*
qrc_*.cpp
moc_*.cpp
moc_*.h
moc_predefs.h
ui_*.h
*.moc

# Qt 构建输出目录
debug/
release/
build-*/
*-build-*/
bin/
obj/
rcc/

